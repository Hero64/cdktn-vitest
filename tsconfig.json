{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "declaration": true,
    "isolatedModules": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": ["vitest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
